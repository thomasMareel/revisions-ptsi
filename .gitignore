# Fichiers système (Windows / macOS)
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store

# Éditeurs / IDE
.vscode/
.idea/
*.swp
*~

# Config locale Claude Code
.claude/

# Original pristine, gardé en local seulement (l'historique git et les branches
# sauvegarde-avant-* servent de points de retour)
fichier de départ/

# Manuels de référence (copyright, gros fichiers) — usage local uniquement
livres supports/

# Ressources matimatheque.fr (copyright, étude de structure) — usage local uniquement
matimatheque/

# Cours PT Spé (gros PDF) — sauvegardés dans le dépôt PRIVÉ thomasMareel/cours-pt-spe (releases), jamais ici (dépôt public)
PT, Spé/

# Divers
*.log
.tmp/

# Tests navigateur (voir tests/README.md)
# - dépendances installées localement par « npm install » (Playwright)
node_modules/
package-lock.json
# - résultats de chaque lancement (captures d'écran + rapport.json), régénérés à chaque fois
tests/sortie/

# Cours vidéo (voir video/README.md) : seules les sources sont versionnées, jamais les fichiers produits
video/**/audio/
video/**/media_*/
video/**/out/
video/**/logs/
video/**/__pycache__/
video/**/narration*.wav
video/**/rapport.json
*.mp4
*.wav
*.mp3
# LaTeX : fichiers de compilation et PDF produits
video/**/*.aux
video/**/*.toc
video/**/*.out
video/**/pdf/*.pdf

# Secrets : aucune clé dans ce dépôt public (clé Mistral = secret de l'environnement cloud)
.env
*.env
.secrets/
